# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Port Vite's dev server listens on.
PORT=5173

# Base path the app is served from. Use "/" for local dev.
BASE_PATH=/

# Must match api-server's API_SHARED_SECRET exactly (empty if that's unset).
# Baked into the built JS bundle at build time — not a real secret once
# deployed publicly, just enough to deter automated abuse of the API.
VITE_API_SHARED_SECRET=
