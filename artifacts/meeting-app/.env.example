# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Port Vite's dev server listens on.
PORT=5173

# Base path the app is served from. Use "/" for local dev.
BASE_PATH=/

# Supabase project (Settings → API). Same project as api-server's
# SUPABASE_URL/SUPABASE_KEY. Use the plain project URL (no /rest/v1 path)
# and the anon/public key — both are safe to ship in the built JS bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
