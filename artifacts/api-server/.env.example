# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Port the Express server listens on. meeting-app's dev proxy expects 8080.
PORT=8080
NODE_ENV=development

# Supabase project (Settings → API). Only the base project URL is needed —
# a full REST path (…/rest/v1) also works, it gets stripped to the origin.
SUPABASE_URL=
# The anon/public key (not the service_role key).
SUPABASE_KEY=

# Anthropic API key for the project/meeting chat feature.
ANTHROPIC_API_KEY=

# Cloudinary (Dashboard → Account Details) — used for image/audio uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gladia (gladia.io) — audio transcription with speaker diarization.
GLADIA_API_KEY=

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Shared secret the frontend must send as `Authorization: Bearer <secret>`.
# Deters drive-by bots from hitting a public deployment and running up your
# Anthropic/Cloudinary/Gladia usage — not real user auth. Leave unset to
# disable (fine for pure localhost dev). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SHARED_SECRET=

# Comma-separated browser origins allowed to call this API (CORS).
# Must match wherever meeting-app is actually served from.
ALLOWED_ORIGINS=http://localhost:5173
